{
  "permissions": {
    "allow": ["Bash(gh pr merge:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/sync-worktree-local-files.sh\"",
            "timeout": 600,
            "statusMessage": "Syncing local files into worktree"
          }
        ]
      }
    ]
  }
}
